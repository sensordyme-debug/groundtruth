# Copy to .env (git-ignored) and fill in. Never commit .env. Keys are read by engine/groundtruth/places/credentials.py
# from the process environment first, then this file. They are never logged or returned by the API.

# Foursquare Places API service key (sent as "Authorization: Bearer <key>"). https://foursquare.com/developers/
FOURSQUARE_API_KEY=

# Yelp Places API private API key (sent as "Authorization: Bearer <key>").
YELP_API_KEY=
# Yelp Client ID: an app identifier, NOT a credential. Optional; only reported as present/absent, never sent.
YELP_CLIENT_ID=

# Google Maps Platform server key. The google provider is DISABLED in engine/groundtruth/conf/providers.json
# (project rule "no Google data" + Maps terms on non-Google maps); a key alone does not enable it.
GOOGLE_MAPS_API_KEY=

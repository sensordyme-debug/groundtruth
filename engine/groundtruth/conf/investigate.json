  "rank_rule": {
    "_doc": "No invented risk score. Results are ORDERED by explicit, documented keys; missing values sort last and are shown as unavailable.",
    "keys": [
      {
        "prop": "flood_kind",
        "order": [
          "100yr",
          "500yr",
          null
        ],
        "label": "flood zone (100-year first)"
      },
      {
        "prop": "elev_above_bfe_m",
        "dir": "asc",
        "label": "height above the base flood elevation (lowest first)"
      },
      {
        "prop": "shore_dist_m",
        "dir": "asc",
        "label": "distance to the shore (closest first)"
      }
    ]
  },
  "detection_quality": {
    "_doc": "What is known about each detector's precision. null = not measured for this data version; never shown as a probability.",
    "house_with_pool": {
      "precision": null,
      "n": null,
      "note": "eye-checked 24–27/30 on an earlier draft (draft0); the v1 set is not re-measured"
    },
    "lakefront": {
      "precision": null,
      "n": null,
      "note": "eye-checked about 22/30 on draft0; not re-measured for v1"
    },
    "has_dock": {
      "precision": null,
      "n": null,
      "note": "eye-checked 23–24/30 on draft1; not re-measured for v1"
    },
    "swimming_pool": {
      "precision": 0.583,
      "n": 24,
      "note": "pool search precision@24 (docs/EVALUATION.md)"
    },
    "boat_dock": {
      "precision": 1.0,
      "n": 12,
      "note": "open-vocabulary boat docks 12/12 eye-checked (docs/EVALUATION.md)"
    }
  },
  "strength": {
    "_doc": "Evidence strength, weakest link wins along a dependency chain.",
    "authoritative_layer": "strong",
    "measured_model_min_precision": 0.8,
    "measured_model_ok": "moderate",
    "unmeasured_model": "weak",
    "missing": "insufficient"
  },
  "limits": {
    "max_steps": 12,
    "step_timeout_s": 120,
    "max_features_kept": 5000,
    "top_findings": 10
  },
  "suggest_places": [
    "Lake Norman",
    "Ballantyne",
    "Myers Park"
  ],
  "find_like": {
    "_doc": "Point at anything: per-click calibration against the area's own background. A candidate is kept only when its patch is more similar to the examples than bg_quantile of randomly sampled background patches in the same area, and closer to the examples than to any 'not this' example (+margin).",
    "bg_samples": 3000,
    "bg_quantile": 0.995,
    "neg_margin": 0.0,
    "seed": 7,
    "outline_top": 60
  },
  "near_layers": {
    "_doc": "distance conditions ('within 500 m of a light-rail station', 'near I-485') map to an OSM layer in data/layers; the first entry whose words appear wins, so specific phrases come first. 'near' with no distance uses near_default_m and says so as an assumption.",
    "near_default_m": 400,
    "layers": [
      {
        "words": [
          "light rail station",
          "light-rail station",
          "lynx station",
          "rail station",
          "transit station"
        ],
        "layer": "osm_light_rail_stations",
        "label": "a light-rail station"
      },
      {
        "words": [
          "light rail",
          "light-rail",
          "lynx",
          "blue line"
        ],
        "layer": "osm_light_rail",
        "label": "the light-rail line"
      },
      {
        "words": [
          "i-485",
          "i485",
          "interstate 485",
          "485"
        ],
        "layer": "osm_i485",
        "label": "I-485"
      },
      {
        "words": [
          "i-77",
          "i77",
          "interstate 77"
        ],
        "layer": "osm_i77",
        "label": "I-77"
      },
      {
        "words": [
          "i-85",
          "i85",
          "interstate 85"
        ],
        "layer": "osm_i85",
        "label": "I-85"
      },
      {
        "words": [
          "interstate",
          "motorway",
          "highway",
          "freeway"
        ],
        "layer": "osm_motorways",
        "label": "a motorway"
      },
      {
        "words": [
          "major road",
          "main road",
          "arterial"
        ],
        "layer": "osm_major_roads",
        "label": "a major road"
      },
      {
        "words": [
          "warehouse"
        ],
        "layer": "osm_warehouses",
        "label": "a warehouse"
      },
      {
        "words": [
          "unc charlotte",
          "uncc",
          "campus"
        ],
        "layer": "osm_unc_charlotte_campus",
        "label": "UNC Charlotte's campus"
      }
    ]
  },
  "steep_slope": {
    "_doc": "'steep' = a mean slope above deg (lidar 2016 ground model, 1 m). 8.5° ≈ a 15 % grade, a common steep-slope threshold in US land-use codes; stated in the plan as an assumption.",
    "deg": 8.5
  },
  "condition_cues": {
    "_doc": "phrases that look like a condition. After planning, any cue whose kind was not applied is reported as 'Not applied' in the plan and the headline: a condition is never dropped silently. Place names (the scope) are removed before scanning.",
    "cues": [
      [
        "\\bwithin \\d[\\d.,]* ?(?:m|km|meters?|metres?|kilometers?|kilometres?|miles?|mi|feet|ft)\\b",
        "near"
      ],
      [
        "\\b(?:near(?:by)?|close to|next to|adjacent to|beside)\\b",
        "near"
      ],
      [
        "\\b(?:slopes?|steep|hillsides?|grade)\\b",
        "slope"
      ],
      [
        "\\bfloodways?\\b",
        "flood"
      ],
      [
        "\\b(?:canopy|trees?|shaded|shade)\\b",
        "canopy"
      ],
      [
        "\\b(?:older|newer)\\b|\\b(?:built|constructed) (?:before|after|since|in)\\b",
        "age"
      ],
      [
        "\\b(?:bigger|larger|smaller|wider|narrower) than\\b|\\bat least \\d",
        "size"
      ],
      [
        "\\b(?:taller|higher|shorter|lower) than\\b",
        "height"
      ],
      [
        "\\bcompare\\b|\\bbetween 20\\d\\d and 20\\d\\d\\b|\\bchanged?\\b|\\bwhat'?s new\\b",
        "compare"
      ],
      [
        "\\b(?:vacant|abandoned|unpermitted|illegal|for sale|values?|prices?|insur\\w*|permits?)\\b",
        "unsupported"
      ]
    ]
  },
  "scenario_request": {
    "_doc": "hypothetical high-water questions → the scenario exposure plan (simulate → exposure per target → cluster). Only for places with a scenario in conf/scenarios.json.",
    "pattern": "\\b(hypothetical|scenario|what if|elevated[- ]water|high[- ]water|water (?:level|rises?|rose)|lake (?:rises?|level)|extreme rain\\w*|flood scenario)\\b",
    "default_offset_m": 1.0,
    "facility_within_m": 500,
    "targets": {
      "roads": "\\broads?\\b|\\bstreets?\\b|\\btransport",
      "bridges": "\\bbridges?\\b",
      "facilities": "\\bfacilit|\\bhospitals?\\b|\\bfire\\b|\\bems\\b|\\bemergency\\b|\\bschools?\\b|\\bpolice\\b|\\bshelters?\\b"
    }
  }
}
